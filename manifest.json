{
  "schemaVersion": 1,
  "id": "com.github.dtotheatothevtothee.omatimeatbandcamp",
  "name": "OmaTimeAtBandcamp",
  "version": "1.0.0-beta.1",
  "author": "dtotheatothevtothee",
  "license": "MIT",
  "description": "Your Bandcamp collection and playlists in an Omarchy bar panel. Streams through Bandcamp's official Subsonic API and plays through mpv. Imports your browser session automatically, shows your real collection including pre-orders, and works with the keyboard.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaTimeAtBandcamp",
    "description": "Bandcamp player for your collection and playlists",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showIcon": true,
      "userUrl": "",
      "cookiePath": "",
      "browser": "auto",
      "includePlaylists": true,
      "refreshIntervalMin": 15,
      "autoPlayOnSelect": false,
      "mpvFlags": ""
    },
    "schema": [
      {
        "key": "userUrl",
        "type": "text",
        "label": "Bandcamp collection URL (blank = auto-detect from your browser login)",
        "defaultValue": ""
      },
      {
        "key": "cookiePath",
        "type": "text",
        "label": "Netscape cookie file (optional — auto-imported from your browser when blank)",
        "defaultValue": ""
      },
      {
        "key": "browser",
        "type": "enum",
        "label": "Browser to import the Bandcamp session from",
        "options": [
          "auto",
          "chrome",
          "chromium",
          "brave",
          "edge",
          "vivaldi",
          "firefox"
        ],
        "defaultValue": "auto"
      },
      {
        "key": "includePlaylists",
        "type": "boolean",
        "label": "Include playlists",
        "defaultValue": true
      },
      {
        "key": "refreshIntervalMin",
        "type": "integer",
        "label": "Library refresh interval (minutes)",
        "min": 5,
        "max": 240,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "autoPlayOnSelect",
        "type": "boolean",
        "label": "Auto-play when selecting a track",
        "defaultValue": false
      },
      {
        "key": "mpvFlags",
        "type": "text",
        "label": "Extra mpv flags (passed via OMATIME_MPV_FLAGS)",
        "defaultValue": ""
      }
    ]
  }
}
