  readonly property var pathData: pathModel.map(function(p) { return p.d })
  readonly property int pathCount: pathModel.length
  readonly property bool isVector: true

  implicitWidth: artWidth
  implicitHeight: artHeight

  // The SVG's own coordinate space, scaled uniformly into the fitted size that
  // Panel.qml assigns. The scale is visual only; the Item's width/height stay
  // the fit box the geometry checks measure.
  Item {
    id: artLayer
    width: root.artWidth
    height: root.artHeight
    transform: Scale {
      xScale: root.width / root.artWidth
      yScale: root.height / root.artHeight
    }

    // Each SVG path is a separate filled Shape because Qt Quick Shapes has no
    // per-ShapePath transform; the file's translate() sits on the Shape.
    Repeater {
      model: root.pathModel
      delegate: Shape {
        objectName: "catPath" + index
        anchors.fill: parent
        antialiasing: true
        transform: Translate { x: modelData.tx; y: modelData.ty }

        ShapePath {
          fillColor: root.tintColor
          strokeColor: "transparent"
          strokeWidth: 0
          // The SVG default is the nonzero winding rule.
          fillRule: ShapePath.WindingFill
          PathSvg { path: modelData.d }
        }
      }
    }
  }
